      "disabled": true,
      "credentials": {
        "smtp": {
          "id": "fDgAUoIsnzcWTzvD",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"Feedback received\" } }}"
