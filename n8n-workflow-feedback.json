      "typeVersion": 1.1,
      "position": [
        1190,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.event }}",
              "operation": "equals",
              "value2": "feedback-response"
            }
          ]
        }
      },
      "id": "if-feedback-response",
