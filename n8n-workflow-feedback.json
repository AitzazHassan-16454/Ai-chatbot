        "operation": "send",
        "from": "={{ $env.TWILIO_WHATSAPP_NUMBER }}",
        "to": "={{ 'whatsapp:' + $json.toWhatsApp }}",
        "body": "=*Thank You for Your Feedback!*\n\nHello {{ $json.toName }},\n\n{{ $json.category === 'bug' ? 'Thank you for reporting this issue. We appreciate your help in making our service better.' : ($json.category === 'feature' ? 'Thank you for your feature suggestion! We love hearing ideas from our users.' : 'Thank you for sharing your feedback with us. It helps us improve!') }}\n\n*Feedback Details:*\n- Category: {{ $json.category }}\n- Rating: {{ $json.rating ? '\u2605'.repeat($json.rating) + '\u2606'.repeat(5 - $json.rating) : 'Not provided' }}\n- Submitted: {{ $json.submittedAt }}\n\n*Your Message:*\n{{ $json.message }}\n\nWe hope you continue to enjoy using AI Chatbot!\n\n_This is an automated message._",
        "options": {}
      },
      "id": "send-whatsapp-response",
      "name": "Send WhatsApp Thank You",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 2,
      "position": [
        1190,
        550
      ],
      "credentials": {
        "twilioApi": {
          "id": "YOUR_TWILIO_CREDENTIAL_ID",
          "name": "Twilio account"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=*New Feedback Received*\n\n*From:* {{ $json.userName }} ({{ $json.userEmail }})\n*Category:* {{ $json.category }}\n*Rating:* {{ $json.rating ? '\u2605'.repeat($json.rating) + '\u2606'.repeat(5 - $json.rating) : 'Not provided' }}\n*Page:* {{ $json.pageContext }}\n*Time:* {{ $json.timestamp }}\n\n*Message:*\n{{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-notify",
      "name": "Telegram Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        950,
        200
      ],
      "disabled": true
    },
    {
      "parameters": {
        "subject": "=New Feedback: {{ $json.category }} from {{ $json.userName }}",
        "message": "=<h2>New Feedback Received</h2><p><strong>From:</strong> {{ $json.userName }} ({{ $json.userEmail }})</p><p><strong>Category:</strong> {{ $json.category }}</p><p><strong>Rating:</strong> {{ $json.rating ? '\u2605'.repeat($json.rating) + '\u2606'.repeat(5 - $json.rating) : 'Not provided' }}</p><p><strong>Page:</strong> {{ $json.pageContext }}</p><p><strong>Time:</strong> {{ $json.timestamp }}</p><hr><p><strong>Message:</strong></p><p>{{ $json.message }}</p>",
        "fromEmail": "aitzazhassan16454@gmail.com",
        "toEmail": "={{ $env.FEEDBACK_EMAIL }}",
        "emailFormat": "html",
        "options": {}
      },
