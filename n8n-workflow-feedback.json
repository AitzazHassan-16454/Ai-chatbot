          "string": [
            {
              "value1": "={{ $json.body.event }}",
              "operation": "equals",
              "value2": "feedback"
            }
          ]
        }
      },
      "id": "if-feedback",
      "name": "IF - Feedback",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
