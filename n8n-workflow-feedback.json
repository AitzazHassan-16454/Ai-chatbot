        "message": "=<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0\"></head><body style=\"margin:0;padding:0;background-color:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f8fafc;padding:40px 0;\"><tr><td align=\"center\"><table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.06);\"><tr><td style=\"background:linear-gradient(135deg,#1e293b 0%,#334155 100%);padding:48px 40px;text-align:center;\"><div style=\"width:56px;height:56px;background:rgba(255,255,255,0.15);border-radius:14px;margin:0 auto 20px;line-height:56px;font-size:28px;\">&#9998;</div><h1 style=\"color:#ffffff;margin:0;font-size:26px;font-weight:700;letter-spacing:-0.5px;\">Thank You!</h1><p style=\"color:rgba(255,255,255,0.7);margin:10px 0 0;font-size:15px;\">Your feedback helps us build a better experience</p></td></tr><tr><td style=\"padding:44px 40px;\"><p style=\"color:#1e293b;font-size:17px;margin:0 0 8px;\">Hello <strong>{{ $json.toName }}</strong>,</p>{{ $json.category === 'bug' ? '<p style=\"color:#64748b;font-size:15px;line-height:1.75;margin:0 0 28px;\">Thank you for taking the time to report this issue. Your feedback helps us identify and fix problems to improve the experience for everyone.</p>' : ($json.category === 'feature' ? '<p style=\"color:#64748b;font-size:15px;line-height:1.75;margin:0 0 28px;\">Thank you for sharing your feature suggestion! We love hearing ideas from our users, and your input helps us shape the future of AI Chatbot.</p>' : '<p style=\"color:#64748b;font-size:15px;line-height:1.75;margin:0 0 28px;\">Thank you for sharing your thoughts with us. Your feedback is invaluable in helping us improve and deliver a better experience.</p>') }}<table width=\"100%\" style=\"background-color:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:24px;\"><tr><td style=\"padding:24px 28px;\"><p style=\"color:#64748b;font-size:13px;font-weight:700;margin:0 0 16px;text-transform:uppercase;letter-spacing:0.8px;\">Feedback Summary</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:8px 0;color:#64748b;font-size:14px;border-bottom:1px solid #e2e8f0;\">Category</td><td style=\"padding:8px 0;color:#1e293b;font-size:14px;font-weight:600;text-align:right;border-bottom:1px solid #e2e8f0;text-transform:capitalize;\">{{ $json.category }}</td></tr>{{ $json.rating ? '<tr><td style=\"padding:8px 0;color:#64748b;font-size:14px;border-bottom:1px solid #e2e8f0;\">Rating</td><td style=\"padding:8px 0;color:#f59e0b;font-size:14px;font-weight:600;text-align:right;border-bottom:1px solid #e2e8f0;\">' + '\u2605'.repeat($json.rating) + '\u2606'.repeat(5 - $json.rating) + '</td></tr>' : '' }}<tr><td style=\"padding:8px 0;color:#64748b;font-size:14px;\">Submitted</td><td style=\"padding:8px 0;color:#1e293b;font-size:14px;font-weight:600;text-align:right;\">{{ $json.submittedAt }}</td></tr></table></td></tr></table><table width=\"100%\" style=\"background-color:#eff6ff;border-radius:12px;border:1px solid #bfdbfe;margin-bottom:28px;\"><tr><td style=\"padding:24px 28px;\"><p style=\"color:#1d4ed8;font-size:13px;font-weight:700;margin:0 0 10px;text-transform:uppercase;letter-spacing:0.5px;\">Your Message</p><p style=\"color:#334155;font-size:14px;line-height:1.7;margin:0;padding-left:16px;border-left:3px solid #3b82f6;\">{{ $json.message }}</p></td></tr></table>{{ $json.category === 'bug' ? '<table width=\"100%\" style=\"margin-bottom:24px;\"><tr><td><p style=\"color:#1e293b;font-size:15px;font-weight:700;margin:0 0 14px;\">What Happens Next</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:7px 0;color:#64748b;font-size:14px;line-height:1.6;\">&#10003;&nbsp; Our team will review the issue you reported</td></tr><tr><td style=\"padding:7px 0;color:#64748b;font-size:14px;line-height:1.6;\">&#10003;&nbsp; We will investigate and work on a fix</td></tr><tr><td style=\"padding:7px 0;color:#64748b;font-size:14px;line-height:1.6;\">&#10003;&nbsp; Updates will be included in future releases</td></tr></table></td></tr></table>' : ($json.category === 'feature' ? '<table width=\"100%\" style=\"margin-bottom:24px;\"><tr><td><p style=\"color:#1e293b;font-size:15px;font-weight:700;margin:0 0 14px;\">What Happens Next</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:7px 0;color:#64748b;font-size:14px;line-height:1.6;\">&#10003;&nbsp; Your suggestion has been added to our roadmap</td></tr><tr><td style=\"padding:7px 0;color:#64748b;font-size:14px;line-height:1.6;\">&#10003;&nbsp; We evaluate features based on user interest</td></tr><tr><td style=\"padding:7px 0;color:#64748b;font-size:14px;line-height:1.6;\">&#10003;&nbsp; We will notify you if this feature gets implemented</td></tr></table></td></tr></table>' : '') }}<p style=\"color:#94a3b8;font-size:14px;line-height:1.7;margin:0 0 32px;\">If you have any additional thoughts, feel free to reply to this email. We read every message.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\"><a href=\"http://localhost:8000\" style=\"display:inline-block;background:linear-gradient(135deg,#1e293b 0%,#334155 100%);color:#ffffff;text-decoration:none;padding:14px 44px;border-radius:10px;font-size:15px;font-weight:600;letter-spacing:0.2px;\">Continue Chatting &rarr;</a></td></tr></table></td></tr><tr><td style=\"background-color:#f8fafc;padding:28px 40px;border-top:1px solid #e2e8f0;\"><p style=\"color:#94a3b8;font-size:12px;margin:0;text-align:center;line-height:1.6;\">This is an automated message from AI Chatbot. If you have questions, reply to this email.</p><p style=\"color:#cbd5e1;font-size:12px;margin:8px 0 0;text-align:center;\">&copy; 2026 AI Chatbot. All rights reserved.</p></td></tr></table></td></tr></table></body></html>",
        "fromEmail": "aitzazhassan16454@gmail.com",
